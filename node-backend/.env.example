DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
APP_ENCRYPTION_KEY_CURRENT=current:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Optional previous key kept only during rotations.
APP_ENCRYPTION_KEY_PREVIOUS=
STRATEGY_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
PORT=3000
NODE_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_MAX_TOKENS=
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_MS=30000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
# Production enforces CSP by default. Set to true only when you explicitly want
# report-only mode in a trusted environment during rollout verification.
CSP_REPORT_ONLY=false
HSTS_ENABLED=true
HSTS_MAX_AGE=15552000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
# Set true only behind one trusted reverse proxy.
TRUST_PROXY=false
ALLOW_TEST_ENV_RUNTIME=false

# IBKR connection diagnostics only.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=11
IBKR_MODE=paper

# Primary broker routing defaults.
DEFAULT_BROKER_PROVIDER=MOOMOO

# MOOMOO OpenD connection.
MOOMOO_OPEND_HOST=127.0.0.1
MOOMOO_OPEND_PORT=11111
MOOMOO_TRANSPORT=websocket
MOOMOO_SECURITY_FIRM=FUTUSECURITIES
MOOMOO_DEFAULT_TRD_ENV=SIMULATE
MOOMOO_DEFAULT_ACC_ID=
MOOMOO_MARKET=US
MOOMOO_WEBSOCKET_SSL=false
MOOMOO_WEBSOCKET_KEY=
# Optional, only needed for REAL trading sessions. Must already be MD5-lowercase.
MOOMOO_TRADING_PASSWORD_MD5=
