# Internal token used by Python scanner/pre-trade jobs to call the governed Node AI gateway.
# Required in production. In local development/test only, JWT_SECRET is used as fallback if omitted.
AI_INTERNAL_GATEWAY_TOKEN=
# Separate burst limit for token-authenticated Python scanner/pre-trade AI calls.
AI_INTERNAL_GATEWAY_RATE_LIMIT_PER_MINUTE=300
NODE_AI_GATEWAY_URL=http://127.0.0.1:3000/internal/ai/news-reasoning
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
# Production enforces CSP by default. Set to true only when you explicitly want
# report-only mode in a trusted environment during rollout verification.
CSP_REPORT_ONLY=false
HSTS_ENABLED=true
HSTS_MAX_AGE=15552000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
# Set true only behind one trusted reverse proxy.
TRUST_PROXY=false
ALLOW_TEST_ENV_RUNTIME=false

# IBKR connection diagnostics only.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=11
IBKR_MODE=paper

