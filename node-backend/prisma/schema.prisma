  limitPrice    Float?
  status        String
  submittedAt   DateTime?
  lastUpdatedAt DateTime
  lastSyncedAt  DateTime?
  metadata      Json?
  fills         BrokerFill[]
  events        BrokerOrderEvent[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([userId, clientOrderId])
  @@index([userId, status])
  @@index([userId, approvalId])
  @@index([userId, submittedAt])
  @@index([userId, brokerOrderId])
}

model BrokerFill {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerOrderId String
  brokerOrder   BrokerOrder @relation(fields: [brokerOrderId], references: [id], onDelete: Cascade)
  symbol        String
  side          TradeSide
  quantity      Float
  price         Float
  commission    Float?
  filledAt      DateTime
  executionId   String?
  raw           Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId, filledAt])
  @@index([userId, brokerOrderId])
  @@unique([userId, executionId])
}

model BrokerOrderEvent {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  brokerOrderId String
  brokerOrder   BrokerOrder @relation(fields: [brokerOrderId], references: [id], onDelete: Cascade)
  eventType     String
  payload       Json?
  createdAt     DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([userId, brokerOrderId])
  @@index([userId, eventType])
}

model EngineStatus {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
