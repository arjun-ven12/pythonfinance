generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Signal {
  BUY
  HOLD
  SELL
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
  FILLED
  CANCELLED
  REJECTED
}

enum OrderType {
  MARKET
  LIMIT
}

enum LedgerEventType {
  ORDER_CREATED
  ORDER_APPROVED
  ORDER_REJECTED
  ORDER_EXECUTED
  BUY_FILL
  SELL_FILL
  FEE
  CASH_DEPOSIT
  CASH_WITHDRAWAL
  POSITION_MARK_TO_MARKET
  POSITION_CLOSE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SNOOZED
  EXECUTED
}

enum ApprovalMode {
  MANUAL_APPROVAL
  SEMI_AUTOMATED
  FULL_AUTOMATION
}

enum BrokerExecutionMode {
  READ_ONLY
  PAPER_BROKER
  LIVE_DRY_RUN
  LIVE_SUPERVISED
  LIVE_LOCKED
}

enum PlaybookRecommendationStatus {
  PENDING_REVIEW
  ACCEPTED
  REJECTED
  CONVERTED_TO_DRAFT
}

enum StockUniverseType {
  MANUAL
  WATCHLIST
  SECTOR
  INDUSTRY
  S_AND_P_500_SAMPLE
  CUSTOM_SCREEN
}

enum ScanJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TIMEOUT
}

enum ScanJobType {
  MANUAL
  SCHEDULED
}

enum StrategyDeploymentStatus {
  DRAFT
  RESEARCH
  CANDIDATE
  ACTIVE
  ARCHIVED
}

enum StrategyAllocationMethod {
  EQUAL_WEIGHT
  MANUAL_WEIGHT
  RISK_PARITY
  CONFIDENCE_WEIGHTED
  EVIDENCE_WEIGHTED
  VOLATILITY_ADJUSTED
}

enum StrategyAllocationCellStatus {
  ACTIVE
  PENDING
  SIT_OUT
  BLOCKED
}

enum ValidationEvaluationStatus {
  PENDING
  MATURED
  FAILED
  SKIPPED
}

enum AlertCategory {
  SCANNER
  APPROVAL
  RISK
  PORTFOLIO
  ENGINE
  BROKER
  VALIDATION
  SYSTEM
}

enum AlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  SNOOZED
  RESOLVED
  EXPIRED
}

enum AlertSource {
  SCAN
  RULE
  MANUAL
  SYSTEM
}

enum AlertDeliveryStatus {
  PENDING
  SENDING
  SENT
  FAILED
  RETRYING
}

enum UserRole {
  LEVEL_1_USER
  LEVEL_2_ADMIN
  LEVEL_3_OWNER_ADMIN
}

enum VerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum AppPageKey {
  DASHBOARD
  SCANNER
  WATCHLIST
  STRATEGY_LAB
  PLAYBOOK
  VALIDATION
  BROKER
  ALERTS
  TRADES
  APPROVALS
  PORTFOLIO
  SETTINGS
  ADMIN_DASHBOARD
}

enum AdminAuditAction {
  VERIFY_USER
  REJECT_USER
  SUSPEND_USER
  PROMOTE_ROLE
  DEMOTE_ROLE
  GRANT_PAGE_ACCESS
  REVOKE_PAGE_ACCESS
}

model Scan {
  id             String                @id @default(uuid())
  externalScanId String?
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyVersionId String?
  generatedAt    DateTime              @default(now())
  scanDuration   Float?
  marketRegime   String?
  riskMultiplier Float?
  source         String                @default("scanner")
  raw            Json?
  opportunities  Opportunity[]
  alerts         Alert[]
  performance    StrategyPerformance[]
  playbookRuns   PlaybookRun[]

  @@unique([userId, externalScanId])
  @@index([strategyVersionId])
  @@index([userId, generatedAt])
  @@index([generatedAt])
}

model Opportunity {
  id                       String    @id @default(uuid())
  scanId                   String
  scan                     Scan      @relation(fields: [scanId], references: [id], onDelete: Cascade)
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyVersionId        String?
  fitScore                 Float?
  regimeAtSignal           String?
  sectorContext            String?
  instrumentType           String?
  symbol                   String
  signal                   Signal
  signalScore              Float?
  confidence               Float
  finalConfidence          Float?
  confidenceBreakdown      Json?
  opportunityScore         Float
  ruleSnapshot             Json?
  sector                   String?
  market                   String?
  exchange                 String?
  currency                 String?
  country                  String?
  displaySymbol            String?
  yahooSymbol              String?
  marketRegime             String?
  scanTimestamp            DateTime?
  close                    Float?
  rsi                      Float?
  backtestReturn           Float?
  buyAndHoldReturn         Float?
  winRate                  Float?
  drawdown                 Float?
  sharpeRatio              Float?
  profitFactor             Float?
  expectancyPerTrade       Float?
  averageHoldingPeriodDays Float?
  annualizedReturn         Float?
  volatility               Float?
  trades                   Int?
  reasons                  Json?
  raw                      Json?
  createdAt                DateTime  @default(now())

  @@index([symbol])
  @@index([signal, opportunityScore])
  @@index([sector])
  @@index([market])
  @@index([exchange])
  @@index([marketRegime])
  @@index([fitScore])
  @@index([regimeAtSignal])
  @@index([scanTimestamp])
  @@index([strategyVersionId])
  @@index([scanId])
  @@index([userId, createdAt])
}

model ValidationSignal {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol             String
  timestamp          DateTime
  signal             Signal
  confidence         Float?
  confidenceBucket   String?
  scannerScore       Float?
  marketRegime       String?
  sector             String?
  market             String?
  exchange           String?
  strategyName       String?
  strategyId         String?
  strategyVersionId  String?
  fitScore           Float?
  regimeAtSignal     String?
  sectorContext      String?
  instrumentType     String?
  horizon            String?
  openAiAdjustment   Float?
  newsAdjustment     Float?
  closePriceAtSignal Float?
  entryPrice         Float?
  exitPrice          Float?
  backtestScore      Float?
  return1d           Float?
  return3d           Float?
  return5d           Float?
  return10d          Float?
  return20d          Float?
  return60d          Float?
  actualReturn       Float?
  maxDrawdown        Float?
  maxRunup           Float?
  maxReturn          Float?
  minReturn          Float?
  drawdown           Float?
  evaluationVolatility Float?
  winLoss            String?
  outcomeDirection   String?
  holdingDays        Int?
  evaluationHorizon  String?
  evaluationStatus   ValidationEvaluationStatus @default(PENDING)
  evaluationError    String?
  evaluatedAt        DateTime?
  raw                Json?
  createdAt          DateTime  @default(now())

  @@unique([userId, symbol, timestamp])
  @@index([userId, createdAt])
  @@index([userId, evaluationStatus, timestamp])
  @@index([confidenceBucket])
  @@index([symbol])
  @@index([timestamp])
  @@index([signal])
  @@index([sector])
  @@index([exchange])
  @@index([strategyName])
  @@index([strategyVersionId])
  @@index([fitScore])
  @@index([horizon])
  @@index([marketRegime])
  @@index([evaluatedAt])
}

model MarketRegimeSnapshot {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  asOfDate    DateTime
  regime      String
  source      String   @default("classifier")
  indexTrend  Float?
  realizedVol Float?
  breadth     Float?
  inputsJson  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, symbol, asOfDate])
  @@index([userId, asOfDate])
  @@index([userId, symbol, asOfDate])
  @@index([regime])
}

model CalibrationMetric {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dimension             String
  bucket                String
  horizon               String
  predictedConfidence   Float?
  actualWinRate         Float?
  avgReturn             Float?
  medianReturn          Float?
  sampleCount           Int
  calibrationError      Float?
  brierScore            Float?
  confidenceInterval    Json?
  evidenceScore         String
  supportingSignalIds   Json?
  generatedAt           DateTime @default(now())

  @@index([userId, generatedAt])
  @@index([userId, dimension, bucket, horizon])
}

model Alert {
  id             String    @id @default(uuid())
  scanId         String?
  scan           Scan?     @relation(fields: [scanId], references: [id], onDelete: SetNull)
  category       AlertCategory @default(SCANNER)
  severity       AlertSeverity @default(MEDIUM)
  status         AlertStatus   @default(ACTIVE)
  source         AlertSource   @default(SCAN)
  symbol         String
  title          String?
  message        String?
  score          Float
  confidence     Float?
  backtestReturn Float?
  drawdown       Float?
  reasons        Json?
  metadata       Json?
  scoreBucket    String?
  dedupeKey      String?
  occurrences    Int       @default(1)
  lastTriggeredAt DateTime?
  generatedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  expiresAt      DateTime?
  acknowledgedAt DateTime?
  snoozedUntil   DateTime?
  resolvedAt     DateTime?
  actionedBy     String?
  actionReason   String?
  sentAt         DateTime?
  channel        String?
  raw            Json?
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     AlertDelivery[]

  @@index([symbol, generatedAt])
  @@index([scanId])
  @@index([userId])
  @@index([userId, status, severity])
  @@index([userId, category, status])
  @@index([userId, lastTriggeredAt])
  @@index([userId, dedupeKey])
  @@unique([userId, dedupeKey])
}

model AlertDelivery {
  id              String              @id @default(uuid())
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertId         String
  alert           Alert               @relation(fields: [alertId], references: [id], onDelete: Cascade)
  channelId       String?
  channel         NotificationChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  status          AlertDeliveryStatus @default(PENDING)
  attempts        Int                 @default(0)
  nextAttemptAt   DateTime?
  lastAttemptAt   DateTime?
  sentAt          DateTime?
  failureReason   String?
  payload         Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([userId, status, nextAttemptAt])
  @@index([alertId])
  @@index([channelId])
}

model AlertRule {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean  @default(true)
  category    AlertCategory?
  severity    AlertSeverity?
  conditions  Json
  actions     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, enabled])
}

model AlertDigest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode        String
  status      String   @default("PENDING")
  alertIds    Json
  title       String
  message     String?
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status, scheduledAt])
}

model Watchlist {
  id        String   @id @default(uuid())
  symbol    String
  notes     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId])
}

model User {
  id                       String                    @id @default(uuid())
  name                     String
  email                    String                    @unique
  passwordHash             String
  role                     UserRole                  @default(LEVEL_1_USER)
  verificationStatus       VerificationStatus        @default(PENDING_VERIFICATION)
  verifiedAt               DateTime?
  verifiedByUserId         String?
  verifiedByUser           User?                     @relation("UserVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedUsers            User[]                    @relation("UserVerifiedBy")
  rejectedAt               DateTime?
  rejectedReason           String?
  lastRoleChangedAt        DateTime?
  roleChangedByUserId      String?
  roleChangedByUser        User?                     @relation("UserRoleChangedBy", fields: [roleChangedByUserId], references: [id], onDelete: SetNull)
  roleChangedUsers         User[]                    @relation("UserRoleChangedBy")
  lastLoginAt              DateTime?
  failedLoginAttempts      Int                       @default(0)
  lockedUntil              DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  alerts                   Alert[]
  watchlist                Watchlist[]
  trades                   Trade[]
  positions                Position[]
  proposedTrades           ProposedTrade[]
  approvalRequests         ApprovalRequest[]
  strategyExperiments      StrategyExperiment[]
  strategyVersions         StrategyVersion[]
  strategyRuns             StrategyRun[]
  walkForwardRuns          WalkForwardRun[]
  strategyStressResults    StrategyStressResult[]
  notificationChannels     NotificationChannel[]
  alertDeliveries          AlertDelivery[]
  alertRules               AlertRule[]
  alertDigests             AlertDigest[]
  settings                 Settings[]
  portfolioStates          PortfolioState[]
  marketDataSnapshots      MarketDataSnapshot[]
  engineRuns               EngineRun[]
  scans                    Scan[]
  opportunities            Opportunity[]
  validationSignals        ValidationSignal[]
  calibrationMetrics       CalibrationMetric[]
  marketRegimeSnapshots    MarketRegimeSnapshot[]
  stockUniverses           StockUniverse[]
  strategyPerformance      StrategyPerformance[]
  paperTrades              PaperTrade[]
  safetySettings           SafetySettings[]
  brokerConfigs            BrokerConfig[]
  brokerSecrets            BrokerSecret[]
  brokerConnectionLogs     BrokerConnectionLog[]
  brokerExecutionAudits    BrokerExecutionAudit[]
  brokerOrders             BrokerOrder[]
  brokerFills              BrokerFill[]
  brokerOrderEvents        BrokerOrderEvent[]
  engineStatuses           EngineStatus[]
  playbooks                Playbook[]
  playbookRuns             PlaybookRun[]
  playbookInsights         PlaybookInsight[]
  playbookSnapshots        PlaybookSnapshot[]
  playbookExports          PlaybookExport[]
  playbookVersions         PlaybookVersion[]
  playbookRecommendations  PlaybookRecommendation[]
  strategyComparisons      StrategyComparison[]
  strategyParameterSweeps  StrategyParameterSweep[]
  strategyDeploymentSets   StrategyDeploymentSet[]
  strategyDeploymentRoutes StrategyDeploymentRoute[]
  strategyCapitalAllocations StrategyCapitalAllocation[]
  strategyAllocationSnapshots StrategyAllocationSnapshot[]
  strategyAllocationAuditLogs      StrategyAllocationAuditLog[] @relation("StrategyAllocationAuditSubject")
  strategyAllocationAuditLogsActor StrategyAllocationAuditLog[] @relation("StrategyAllocationAuditActor")
  transactionLedger        TransactionLedger[]
  portfolioReconciliations PortfolioReconciliation[]
  scanJobs                 ScanJob[]
  refreshTokens            RefreshToken[]
  pageAccessEntries        UserPageAccess[]          @relation("UserPageAccessSubject")
  pageAccessUpdates        UserPageAccess[]          @relation("UserPageAccessUpdatedBy")
  adminAuditLogsActor      AdminAuditLog[]           @relation("AdminAuditActor")
  adminAuditLogsTarget     AdminAuditLog[]           @relation("AdminAuditTarget")

  @@index([email])
  @@index([role, verificationStatus])
  @@index([verifiedByUserId])
  @@index([roleChangedByUserId])
}

model UserPageAccess {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation("UserPageAccessSubject", fields: [userId], references: [id], onDelete: Cascade)
  pageKey         AppPageKey
  allowed         Boolean    @default(true)
  reason          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  updatedByUserId String?
  updatedByUser   User?      @relation("UserPageAccessUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, pageKey])
  @@index([userId])
  @@index([updatedByUserId])
}

model AdminAuditLog {
  id           String           @id @default(uuid())
  actorUserId  String
  actorUser    User             @relation("AdminAuditActor", fields: [actorUserId], references: [id], onDelete: Cascade)
  targetUserId String?
  targetUser   User?            @relation("AdminAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  action       AdminAuditAction
  metadata     Json?
  createdAt    DateTime         @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([action, createdAt])
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?
  ipAddress         String?
  userAgent         String?

  @@index([userId, createdAt])
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model ScanJob {
  id                    String        @id @default(uuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                ScanJobStatus @default(QUEUED)
  type                  ScanJobType   @default(MANUAL)
  startedAt             DateTime?
  finishedAt            DateTime?
  timeoutAt             DateTime?
  progress              Float         @default(0)
  currentStage          String?
  symbolsProcessed      Int           @default(0)
  symbolsTotal          Int           @default(0)
  cancellationRequested Boolean       @default(false)
  pid                   Int?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([userId, type, status])
  @@index([status, timeoutAt])
}

model StockUniverse {
  id           String                @id @default(uuid())
  userId       String
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  universeType StockUniverseType     @default(MANUAL)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  members      StockUniverseMember[]

  @@unique([userId, name])
  @@index([userId, createdAt])
  @@index([universeType])
  @@index([createdAt])
}

model StockUniverseMember {
  id          String        @id @default(uuid())
  universeId  String
  universe    StockUniverse @relation(fields: [universeId], references: [id], onDelete: Cascade)
  symbol      String
  companyName String?
  sector      String?
  industry    String?
  source      String?
  createdAt   DateTime      @default(now())

  @@unique([universeId, symbol])
  @@index([symbol])
  @@index([sector])
  @@index([industry])
  @@index([universeId])
}

model Trade {
  id          String      @id @default(uuid())
  symbol      String
  side        TradeSide
  status      TradeStatus @default(OPEN)
  orderType   OrderType?
  entryPrice  Float
  exitPrice   Float?
  quantity    Float
  stopLoss    Float?
  takeProfit  Float?
  fees        Float       @default(0)
  realizedPnl Float?
  notes       String?
  source      String      @default("manual")
  openedAt    DateTime    @default(now())
  closedAt    DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  raw         Json?
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([symbol])
  @@index([status])
  @@index([openedAt])
  @@index([userId])
  @@index([userId, createdAt])
}

model Position {
  id            String   @id @default(uuid())
  symbol        String
  quantity      Float
  averagePrice  Float
  lastPrice     Float?
  marketValue   Float?
  unrealizedPnl Float?
  sector        String?
  source        String   @default("paper")
  raw           Json?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, symbol])
  @@index([userId])
}

model StrategyPerformance {
  id                       String   @id @default(uuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scanId                   String?
  scan                     Scan?    @relation(fields: [scanId], references: [id], onDelete: SetNull)
  symbol                   String?
  strategyName             String   @default("default")
  totalReturn              Float?
  buyAndHoldReturn         Float?
  winRate                  Float?
  maxDrawdown              Float?
  sharpeRatio              Float?
  profitFactor             Float?
  expectancyPerTrade       Float?
  averageHoldingPeriodDays Float?
  annualizedReturn         Float?
  volatility               Float?
  completedTrades          Int?
  period                   String?
  raw                      Json?
  createdAt                DateTime @default(now())

  @@index([symbol])
  @@index([strategyName])
  @@index([scanId])
  @@index([userId, createdAt])
}

model StrategyExperiment {
  id               String                   @id @default(uuid())
  name             String
  description      String?
  status           String                   @default("DRAFT")
  settingsJson     Json?
  encryptedStrategy String?                 @db.Text
  encryptedStrategyKey String?              @db.Text
  strategyEncryptionIv String?
  strategyEncryptionTag String?
  strategyEncryptionKeyIv String?
  strategyEncryptionKeyTag String?
  strategyEncryptionAlgorithmVersion String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  runs             StrategyRun[]
  versions         StrategyVersion[]
  parameterSweeps  StrategyParameterSweep[]
  walkForwardRuns  WalkForwardRun[]
  stressResults    StrategyStressResult[]
  leftComparisons  StrategyComparison[]     @relation("LeftStrategyExperiment")
  rightComparisons StrategyComparison[]     @relation("RightStrategyExperiment")
  playbookVersions PlaybookVersion[]
  deploymentSetsOwned StrategyDeploymentSet[]   @relation("DeploymentOwnerExperiment")
  deploymentRoutes  StrategyDeploymentRoute[]   @relation("DeploymentRouteExperiment")
  capitalAllocations StrategyCapitalAllocation[]
  allocationAuditLogs StrategyAllocationAuditLog[]
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([userId, createdAt])
}

model StrategyVersion {
  id                  String                   @id @default(uuid())
  userId              String
  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  experimentId        String
  experiment          StrategyExperiment       @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  version             Int
  deploymentStatus    StrategyDeploymentStatus @default(DRAFT)
  strategyJson        Json?
  settingsJson        Json?
  encryptedStrategy   String?                  @db.Text
  encryptedStrategyKey String?                 @db.Text
  strategyEncryptionIv String?
  strategyEncryptionTag String?
  strategyEncryptionKeyIv String?
  strategyEncryptionKeyTag String?
  strategyEncryptionAlgorithmVersion String?
  evidenceJson        Json?
  activationRulesJson Json?
  activatedAt         DateTime?
  archivedAt          DateTime?
  changeNote          String?
  createdAt           DateTime                 @default(now())
  deploymentSetsOwned StrategyDeploymentSet[]  @relation("DeploymentOwnerVersion")
  deploymentRoutes    StrategyDeploymentRoute[] @relation("DeploymentRouteVersion")
  capitalAllocations  StrategyCapitalAllocation[]

  @@unique([experimentId, version])
  @@index([userId, createdAt])
  @@index([userId, deploymentStatus])
  @@index([experimentId, createdAt])
  @@index([experimentId, deploymentStatus])
}

model StrategyDeploymentSet {
  id                   String                    @id @default(uuid())
  userId               String                    @unique
  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String                    @default("Primary Deployment Set")
  ownerExperimentId    String?
  ownerExperiment      StrategyExperiment?       @relation("DeploymentOwnerExperiment", fields: [ownerExperimentId], references: [id], onDelete: SetNull)
  ownerStrategyVersionId String?
  ownerStrategyVersion StrategyVersion?          @relation("DeploymentOwnerVersion", fields: [ownerStrategyVersionId], references: [id], onDelete: SetNull)
  allocationMethod     StrategyAllocationMethod  @default(EQUAL_WEIGHT)
  rebalanceFrequency   String                    @default("WEEKLY")
  maxDriftPct          Float                     @default(5)
  guardrailsJson       Json?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  routes               StrategyDeploymentRoute[]
  capitalAllocations   StrategyCapitalAllocation[]
  snapshots            StrategyAllocationSnapshot[]
  auditLogs            StrategyAllocationAuditLog[]

  @@index([ownerExperimentId])
  @@index([ownerStrategyVersionId])
}

model StrategyDeploymentRoute {
  id                    String                       @id @default(uuid())
  userId                String
