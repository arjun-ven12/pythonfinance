{
  "schemaVersion": "strategy-json/v1",
  "description": "Canonical Strategy Lab contract. Builder state serializes to this shape; Python validates and executes from executable fields only.",
  "allowed": {
    "logicalOperators": ["AND", "OR", "NOT", "GROUP"],
    "indicators": [
      "CLOSE",
      "VOLUME",
      "VOLUME_SMA_20",
      "BREAKOUT_LEVEL",
      "VOLATILITY_20",
      "EMA_FAST",
      "EMA_SLOW",
      "RSI",
      "MACD",
      "ATR",
      "MOMENTUM",
      "PRICE_ABOVE_EMA",
      "VOLATILITY_CONTROLLED",
      "VOLUME_SPIKE",
      "BREAKOUT",
      "SIGNAL_STATE",
      "HOLDING_PERIOD_DAYS"
    ],
    "comparators": [
      ">",
      ">=",
      "<",
      "<=",
      "==",
      "!=",
      "BETWEEN",
      "CROSSES_ABOVE",
      "CROSSES_BELOW",
      "IS_TRUE",
      "STOP_LOSS_ATR",
      "TAKE_PROFIT_ATR",
      "TRAILING_STOP_ATR"
    ],
    "universeTypes": ["SINGLE", "STOCK_UNIVERSE", "WATCHLIST", "SECTOR", "INDUSTRY", "CUSTOM_SCREEN"],
    "markets": ["US_AND_SGX", "US", "SGX"],
    "timeframes": ["1H", "4H", "1D", "1W"],
    "sizingMethods": ["risk_per_trade", "equal_weight", "risk_parity", "vol_targeting", "kelly_capped"],
    "entryTiming": ["next_bar", "delayed_entry"],
    "confirmation": ["close_confirmation", "none"],
    "regimes": [
      "BULL_LOW_VOL",
      "BULL_HIGH_VOL",
      "SIDEWAYS",
      "BEAR_LOW_VOL",
      "BEAR_HIGH_VOL",
      "RISK_OFF"
    ],
    "instrumentTypes": [
      "SINGLE_STOCK",
      "ETF",
      "LEVERAGED_ETF",
      "INVERSE_ETF"
    ]
  },
  "requiredExecutableFields": [
    "universe",
    "timeframe",
    "entryRules",
    "exitRules",
    "positionSizing",
    "riskRules",
    "filters",
    "execution",
    "validation",
    "parameters",
    "weights",
    "envelope",
    "regimeOverlays"
  ],
  "builderControls": {
    "objective": { "path": "metadata.objective", "executable": false, "label": "design note only — sets builder defaults and readiness framing" },
    "template": { "path": "metadata.template", "executable": true, "consumedBy": "compiler/defaults" },
    "universeType": { "path": "executable.universe.type", "executable": true, "consumedBy": "compiler/backtest-universe" },
    "marketBias": { "path": "executable.universe.market", "executable": true, "consumedBy": "compiler/scanner-metadata" },
    "universeId": { "path": "executable.universe.universeId", "executable": true, "consumedBy": "compiler/backtest-universe" },
    "universeName": { "path": "executable.universe.universeName", "executable": true, "consumedBy": "compiler/backtest-universe" },
    "allowedSectors": { "path": "executable.envelope.sectors", "executable": true, "consumedBy": "scanner/fit-check" },
    "allowedRegimes": { "path": "executable.envelope.regimes", "executable": true, "consumedBy": "backtest/regime-routing" },
    "instrumentTypes": { "path": "executable.envelope.instrumentTypes", "executable": true, "consumedBy": "scanner/backtest-instrument-guards" },
    "volatilityMin": { "path": "executable.envelope.volBand.min", "executable": true, "consumedBy": "scanner/fit-check" },
    "volatilityMax": { "path": "executable.envelope.volBand.max", "executable": true, "consumedBy": "scanner/fit-check" },
    "liquidityFloor": { "path": "executable.envelope.liquidityFloor", "executable": true, "consumedBy": "scanner/fit-check" },
    "holdingPeriodDays": { "path": "executable.envelope.holdingPeriodDays", "executable": true, "consumedBy": "backtest/instrument-guards" },
    "regimeOverlays": { "path": "executable.regimeOverlays", "executable": true, "consumedBy": "python.strategy_interpreter" },
    "allocationMatrix": { "path": "executable.allocationMatrix", "executable": true, "consumedBy": "scanner/routing" },
    "primaryTimeframe": { "path": "executable.timeframe.primary", "executable": true, "consumedBy": "compiler/metadata" },
    "entryTimeframe": { "path": "executable.timeframe.entry", "executable": true, "consumedBy": "compiler/metadata" },
    "rules": { "path": "executable.entryRules|exitRules|riskRules", "executable": true, "consumedBy": "python.strategy_interpreter" },
    "sizingMethod": { "path": "executable.positionSizing.method", "executable": true, "consumedBy": "risk-sizing-config" },
    "riskPerTrade": { "path": "executable.positionSizing.riskPerTrade", "executable": true, "consumedBy": "backtest/risk" },
    "sizingPreviewCapital": { "path": "executable.positionSizing.previewCapital", "executable": false, "label": "design note only — preview display, not execution capital" },
    "capitalSimulation": { "path": "research.designNotes.capitalSimulation", "executable": false, "label": "design note only — not executed" },
    "maxDrawdown": { "path": "executable.validation.maxDrawdown", "executable": true, "consumedBy": "promotion-readiness" },
    "maxPositionSize": { "path": "executable.validation.maxPositionSize", "executable": false, "label": "design note only — portfolio-level sizing gate not executed in backtest" },
    "maxSectorExposure": { "path": "executable.validation.maxSectorExposure", "executable": false, "label": "design note only — portfolio-level sector gate not executed in backtest" },
    "maxDailyLoss": { "path": "executable.validation.maxDailyLoss", "executable": false, "label": "design note only — portfolio-level daily loss gate not executed in backtest" },
    "emaFast": { "path": "executable.parameters.emaFast", "executable": true, "consumedBy": "indicators/backtest/scanner" },
    "emaSlow": { "path": "executable.parameters.emaSlow", "executable": true, "consumedBy": "indicators/backtest/scanner" },
    "rsiThreshold": { "path": "executable.parameters.rsiThreshold", "executable": true, "consumedBy": "strategy_interpreter" },
    "atrStopMultiple": { "path": "executable.parameters.atrStopMultiple", "executable": true, "consumedBy": "backtest/trade_rules" },
    "atrTakeProfitMultiple": { "path": "executable.parameters.atrTakeProfitMultiple", "executable": true, "consumedBy": "backtest/trade_rules" },
    "trailingStopAtrMultiple": { "path": "executable.parameters.trailingStopAtrMultiple", "executable": true, "consumedBy": "backtest/trade_rules" },
    "signalThreshold": { "path": "executable.parameters.signalThreshold", "executable": true, "consumedBy": "strategy_interpreter" },
    "technicalWeight": { "path": "executable.weights.technical", "executable": true, "consumedBy": "confidence-breakdown" },
    "regimeWeight": { "path": "executable.weights.regime", "executable": true, "consumedBy": "confidence-breakdown" },
    "newsWeight": { "path": "executable.weights.news", "executable": true, "consumedBy": "confidence-breakdown" },
    "openaiWeight": { "path": "executable.weights.openai", "executable": true, "consumedBy": "confidence-breakdown" },
    "regimeFilter": { "path": "executable.filters.marketRegime", "executable": true, "consumedBy": "scanner/backtest-config" },
    "newsFilter": { "path": "executable.filters.news", "executable": true, "consumedBy": "scanner/backtest-config" },
    "marketHoursOnly": { "path": "executable.filters.marketHoursOnly", "executable": true, "consumedBy": "scanner/scheduler-config" },
    "earningsFilter": { "path": "executable.filters.earnings", "executable": true, "consumedBy": "scanner/news-filter-config" },
    "robustnessMode": { "path": "evidence.robustness.requested", "executable": false, "label": "design note only until robustness job is run" },
    "strategyPrompt": { "path": "research.notes", "executable": false, "label": "design note only — AI/coach cannot emit trades" }
  }
}
