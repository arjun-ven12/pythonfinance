# Optional market/news providers
FINNHUB_API_KEY=

# Notifications are disabled unless explicitly enabled.
SEND_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Paper execution defaults
PAPER_ACCOUNT_VALUE=100000
PAPER_RISK_PER_TRADE=0.01
PAPER_SLIPPAGE_BPS=5
PAPER_FEE_PER_SHARE=0.005
PAPER_MIN_FEE=1

# Safety defaults
SAFETY_ACCOUNT_VALUE=100000
SAFETY_KILL_SWITCH=false
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_POSITION_SIZE_PCT=0.10
MAX_TOTAL_PORTFOLIO_EXPOSURE_PCT=0.80
MAX_SECTOR_EXPOSURE_PCT=0.25
MAX_CORRELATED_EXPOSURE_PCT=0.30
CORRELATION_THRESHOLD=0.80

# IBKR diagnostics only. Use Python 3.11 or 3.12.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=11
IBKR_MODE=paper

# Injected by Node scanner/pre-trade jobs so Python uses the governed Node AI gateway.
NODE_AI_GATEWAY_URL=http://127.0.0.1:3000/internal/ai/news-reasoning
NODE_AI_GATEWAY_TOKEN=
NODE_AI_USER_ID=
